@model PageHeaderViewModel
<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-medium tracking-tight">@Model.Title</h1>
    @if (Model.ShowNewThread)
    {
        <a class="btn btn-primary" asp-controller="Threads" asp-action="CreateThread">New thread</a>
    }
</div>
