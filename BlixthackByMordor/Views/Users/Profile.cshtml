@model ProfileViewModel
@{
    ViewData["Title"] = Model.IsOwner ? "Your profile" : Model.Username;
}

<div class="mx-auto mb-8 flex w-full max-w-2xl flex-col gap-5 md:max-w-4xl">
    <article class="panel">
        <header class="panel-header">
            <p class="eyebrow">@(Model.IsOwner ? "Your profile" : "Profile")</p>
        </header>

        <div class="flex items-center gap-3.5 px-5 pt-5">
            <div class="avatar size-12 text-lg" aria-hidden="true">@Initial(Model.Username)</div>
            <div>
                <h1 class="text-xl font-medium tracking-tight leading-tight">@Model.Username</h1>
                <p class="text-xs text-muted-foreground">
                    Member since
                    <time datetime="@Model.CreatedAt.ToString("O")">
                        @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </time>
                </p>
            </div>
        </div>

        @if (Model.IsOwner)
        {
            <form asp-controller="Users"
                  asp-action="MyProfile"
                  method="post"
                  class="panel-body">
                <div asp-validation-summary="ModelOnly"></div>

                @if (TempData["ProfileSaved"] is true)
                {
                    <p class="alert-success" role="status">Your profile has been updated.</p>
                }

                <div class="field-group">
                    <label asp-for="AboutMe" class="field-label"></label>
                    <textarea asp-for="AboutMe"
                              class="field min-h-24 resize-y"
                              maxlength="500"
                              rows="4"
                              placeholder="Tell others a bit about yourself"></textarea>
                    <p class="field-hint">Optional. Up to 500 characters. This is visible on your public profile.</p>
                    <span asp-validation-for="AboutMe" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Username" class="field-label"></label>
                    <input asp-for="Username"
                           class="field"
                           autocomplete="username"
                           maxlength="50" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Email" class="field-label"></label>
                    <input asp-for="Email"
                           class="field"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <fieldset class="mb-5 rounded-lg border border-border px-4 pt-3.5 pb-1">
                    <legend class="px-1 text-sm font-medium text-foreground">Change password</legend>
                    <p class="mb-4 text-xs text-muted-foreground">Leave these blank to keep your current password.</p>

                    <div class="field-group">
                        <label asp-for="CurrentPassword" class="field-label"></label>
                        <input asp-for="CurrentPassword"
                               class="field"
                               autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="NewPassword" class="field-label"></label>
                        <input asp-for="NewPassword"
                               class="field"
                               autocomplete="new-password"
                               placeholder="At least 6 characters" />
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="ConfirmNewPassword" class="field-label"></label>
                        <input asp-for="ConfirmNewPassword"
                               class="field"
                               autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
                    </div>
                </fieldset>

                <partial name="_FormActions" model='FormActionsViewModel.CancelHome("Save changes")' />
            </form>
        }
        else
        {
            <section class="px-5 pt-4 pb-6" aria-labelledby="about-heading">
                <h2 id="about-heading" class="section-title mb-2">About me</h2>
                @if (string.IsNullOrWhiteSpace(Model.AboutMe))
                {
                    <p class="text-sm text-muted-foreground">This user has not written an about me yet.</p>
                }
                else
                {
                    <p class="prose-body">@Model.AboutMe</p>
                }
            </section>
        }
    </article>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:items-start">
        <partial name="_ProfileList" model="ProfileListViewModel.Threads(Model.Threads)" />
        <partial name="_ProfileList" model="ProfileListViewModel.Answers(Model.Answers)" />
        <partial name="_ProfileList" model="ProfileListViewModel.Favorites(Model.FavoriteAnswers)" />
    </div>
</div>
