@model BlixthackByMordor.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Your profile";
    var initial = string.IsNullOrEmpty(Model.Username)
        ? "?"
        : Model.Username[0].ToString().ToUpperInvariant();
}

<div class="thread-page auth-page">
    <article class="thread-panel">
        <header class="thread-panel__header">
            <p class="thread-panel__category">Your profile</p>
        </header>

        <div class="profile-hero">
            <div class="profile-hero__avatar" aria-hidden="true">@initial</div>
            <div class="profile-hero__meta">
                <h1 class="profile-hero__name">@Model.Username</h1>
                <p class="profile-hero__since">
                    Member since
                    <time datetime="@Model.CreatedAt.ToString("O")">
                        @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </time>
                </p>
            </div>
        </div>

        <form asp-controller="Users"
              asp-action="Profile"
              method="post"
              class="thread-compose">
            <div asp-validation-summary="ModelOnly" class="thread-compose__errors"></div>

            @if (TempData["ProfileSaved"] is true)
            {
                <p class="thread-compose__success" role="status">Your profile has been updated.</p>
            }

            <div class="thread-compose__field">
                <label asp-for="Username" class="thread-compose__label"></label>
                <input asp-for="Username"
                       class="form-control thread-compose__control"
                       autocomplete="username"
                       maxlength="50" />
                <span asp-validation-for="Username" class="thread-compose__field-error"></span>
            </div>

            <div class="thread-compose__field">
                <label asp-for="Email" class="thread-compose__label"></label>
                <input asp-for="Email"
                       class="form-control thread-compose__control"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="thread-compose__field-error"></span>
            </div>

            <fieldset class="profile-password">
                <legend class="profile-password__legend">Change password</legend>
                <p class="thread-compose__hint">Leave these blank to keep your current password.</p>

                <div class="thread-compose__field">
                    <label asp-for="CurrentPassword" class="thread-compose__label"></label>
                    <input asp-for="CurrentPassword"
                           class="form-control thread-compose__control"
                           autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="thread-compose__field-error"></span>
                </div>

                <div class="thread-compose__field">
                    <label asp-for="NewPassword" class="thread-compose__label"></label>
                    <input asp-for="NewPassword"
                           class="form-control thread-compose__control"
                           autocomplete="new-password"
                           placeholder="At least 6 characters" />
                    <span asp-validation-for="NewPassword" class="thread-compose__field-error"></span>
                </div>

                <div class="thread-compose__field">
                    <label asp-for="ConfirmNewPassword" class="thread-compose__label"></label>
                    <input asp-for="ConfirmNewPassword"
                           class="form-control thread-compose__control"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmNewPassword" class="thread-compose__field-error"></span>
                </div>
            </fieldset>

            <div class="thread-compose__actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-light answer-gate__secondary"
                   asp-controller="Home"
                   asp-action="Index">
                    Cancel
                </a>
            </div>
        </form>
    </article>
</div>
