@model BlixthackByMordor.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = Model.IsOwner ? "Your profile" : Model.Username;
    var initial = string.IsNullOrEmpty(Model.Username)
        ? "?"
        : Model.Username[0].ToString().ToUpperInvariant();
}

<div class="thread-page profile-page">
    <article class="thread-panel">
        <header class="thread-panel__header">
            <p class="thread-panel__category">@(Model.IsOwner ? "Your profile" : "Profile")</p>
        </header>

        <div class="profile-hero">
            <div class="profile-hero__avatar" aria-hidden="true">@initial</div>
            <div class="profile-hero__meta">
                <h1 class="profile-hero__name">@Model.Username</h1>
                <p class="profile-hero__since">
                    Member since
                    <time datetime="@Model.CreatedAt.ToString("O")">
                        @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </time>
                </p>
            </div>
        </div>

        @if (Model.IsOwner)
        {
            <form asp-controller="Users"
                  asp-action="MyProfile"
                  method="post"
                  class="thread-compose">
                <div asp-validation-summary="ModelOnly" class="thread-compose__errors"></div>

                @if (TempData["ProfileSaved"] is true)
                {
                    <p class="thread-compose__success" role="status">Your profile has been updated.</p>
                }

                <div class="thread-compose__field">
                    <label asp-for="AboutMe" class="thread-compose__label"></label>
                    <textarea asp-for="AboutMe"
                              class="form-control thread-compose__control thread-compose__textarea profile-about__input"
                              maxlength="500"
                              rows="4"
                              placeholder="Tell others a bit about yourself"></textarea>
                    <p class="thread-compose__hint">Up to 500 characters. This is visible on your public profile.</p>
                    <span asp-validation-for="AboutMe" class="thread-compose__field-error"></span>
                </div>

                <div class="thread-compose__field">
                    <label asp-for="Username" class="thread-compose__label"></label>
                    <input asp-for="Username"
                           class="form-control thread-compose__control"
                           autocomplete="username"
                           maxlength="50" />
                    <span asp-validation-for="Username" class="thread-compose__field-error"></span>
                </div>

                <div class="thread-compose__field">
                    <label asp-for="Email" class="thread-compose__label"></label>
                    <input asp-for="Email"
                           class="form-control thread-compose__control"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="thread-compose__field-error"></span>
                </div>

                <fieldset class="profile-password">
                    <legend class="profile-password__legend">Change password</legend>
                    <p class="thread-compose__hint">Leave these blank to keep your current password.</p>

                    <div class="thread-compose__field">
                        <label asp-for="CurrentPassword" class="thread-compose__label"></label>
                        <input asp-for="CurrentPassword"
                               class="form-control thread-compose__control"
                               autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="thread-compose__field-error"></span>
                    </div>

                    <div class="thread-compose__field">
                        <label asp-for="NewPassword" class="thread-compose__label"></label>
                        <input asp-for="NewPassword"
                               class="form-control thread-compose__control"
                               autocomplete="new-password"
                               placeholder="At least 6 characters" />
                        <span asp-validation-for="NewPassword" class="thread-compose__field-error"></span>
                    </div>

                    <div class="thread-compose__field">
                        <label asp-for="ConfirmNewPassword" class="thread-compose__label"></label>
                        <input asp-for="ConfirmNewPassword"
                               class="form-control thread-compose__control"
                               autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="thread-compose__field-error"></span>
                    </div>
                </fieldset>

                <div class="thread-compose__actions">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a class="btn btn-outline-light answer-gate__secondary"
                       asp-controller="Home"
                       asp-action="Index">
                        Cancel
                    </a>
                </div>
            </form>
        }
        else
        {
            <section class="profile-about" aria-labelledby="about-heading">
                <h2 id="about-heading" class="profile-about__title">About me</h2>
                @if (string.IsNullOrWhiteSpace(Model.AboutMe))
                {
                    <p class="profile-about__empty">This user has not written an about me yet.</p>
                }
                else
                {
                    <p class="profile-about__text">@Model.AboutMe</p>
                }
            </section>
        }
    </article>

    <div class="profile-activity">
    <section class="thread-panel" aria-labelledby="profile-threads-heading">
        <header class="thread-panel__header">
            <h2 id="profile-threads-heading" class="thread-panel__category">Threads</h2>
            <span class="thread-panel__count">@Model.Threads.Count</span>
        </header>
        @if (Model.Threads.Count == 0)
        {
            <p class="profile-activity__empty">No threads yet.</p>
        }
        else
        {
            <ul class="thread-list">
                @foreach (var thread in Model.Threads)
                {
                    <li class="thread-list__item">
                        <a class="thread-item"
                           asp-controller="Threads"
                           asp-action="Details"
                           asp-route-id="@thread.Id">
                            <div class="thread-item__content">
                                <h3 class="thread-item__title">@thread.Title</h3>
                                <div class="thread-item__byline">
                                    <span>@thread.CategoryName</span>
                                    <span aria-hidden="true">&middot;</span>
                                    <time datetime="@thread.CreatedAt.ToString("O")">
                                        @thread.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </time>
                                </div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="thread-panel" aria-labelledby="profile-answers-heading">
        <header class="thread-panel__header">
            <h2 id="profile-answers-heading" class="thread-panel__category">Answers</h2>
            <span class="thread-panel__count">@Model.Answers.Count</span>
        </header>
        @if (Model.Answers.Count == 0)
        {
            <p class="profile-activity__empty">No answers yet.</p>
        }
        else
        {
            <ul class="thread-list">
                @foreach (var answer in Model.Answers)
                {
                    <li class="thread-list__item">
                        <a class="thread-item"
                           asp-controller="Threads"
                           asp-action="Details"
                           asp-route-id="@answer.ThreadId">
                            <div class="thread-item__content">
                                <h3 class="thread-item__title">@answer.Excerpt</h3>
                                <div class="thread-item__byline">
                                    <span>on @answer.ThreadTitle</span>
                                    <span aria-hidden="true">&middot;</span>
                                    <time datetime="@answer.CreatedAt.ToString("O")">
                                        @answer.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </time>
                                </div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>
    </div>
</div>
