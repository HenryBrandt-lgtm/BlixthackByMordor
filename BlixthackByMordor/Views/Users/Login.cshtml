@model BlixthackByMordor.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <article class="panel">
        <header class="panel-header">
            <p class="eyebrow">Log in</p>
        </header>

        <form asp-controller="Users"
              asp-action="Login"
              method="post"
              class="panel-body">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly"></div>

            <div class="field-group">
                <label asp-for="Email" class="field-label"></label>
                <input asp-for="Email"
                       class="field"
                       autocomplete="email"
                       placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Password" class="field-label"></label>
                <input asp-for="Password"
                       type="password"
                       class="field"
                       autocomplete="current-password"
                       placeholder="Your password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <partial name="_FormActions" model='FormActionsViewModel.CancelHome("Log in")' />
        </form>

        <p class="empty pt-0">
            No account yet?
            <a class="link-strong"
               asp-controller="Users"
               asp-action="Register"
               asp-route-returnUrl="@ViewData["ReturnUrl"]">
                Register
            </a>
        </p>
    </article>
</div>
