@model BlixthackByMordor.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Registrera";
}
<div class="text-center">
    <h1 class="mb-5">Register Account</h1>

    <form asp-controller="Users"
          asp-action="Register"
          method="post" class="w-25 mx-auto text-start">

        <div asp-validation-summary="ModelOnly"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label mb-2 fw-bold"></label>

            <input asp-for="Username" class="form-control border border-1 border-dark" />

            <span asp-validation-for="Username"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label mb-2 fw-bold"></label>

            <input asp-for="Email" class="form-control  border border-1 border-dark" />

            <span asp-validation-for="Email"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label mb-2 fw-bold"></label>

            <input asp-for="Password"
                   type="password" class="form-control  border border-1 border-dark" placeholder="Minimum 6 characters" />

            <span asp-validation-for="Password"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label mb-2 fw-bold"></label>

            <input asp-for="ConfirmPassword"
                   type="password" class="form-control border border-1 border-dark" />

            <span asp-validation-for="ConfirmPassword"></span>
        </div>
        <div class="d-flex flex-row justify-content-around gap-3">
            <button type="button" class="btn btn-secondary w-50" onclick="history.back()">Back</button>

            <button type="submit" class="btn btn-primary w-50">
                Register
            </button>
        </div>

        
       
    </form>

    <p class="mt-4">
        <b>
            <i>
                Already have an account?
            </i>
        </b>

        <a asp-controller="Users"
           asp-action="Login">
            Logga in
        </a>
    </p>
</div>