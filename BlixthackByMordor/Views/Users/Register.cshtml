@model BlixthackByMordor.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <article class="panel">
        <header class="panel-header">
            <p class="eyebrow">Register</p>
        </header>

        <form asp-controller="Users"
              asp-action="Register"
              method="post"
              class="panel-body">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly"></div>

            <div class="field-group">
                <label asp-for="Username" class="field-label"></label>
                <input asp-for="Username"
                       class="field"
                       autocomplete="username"
                       maxlength="50"
                       placeholder="Choose a username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Email" class="field-label"></label>
                <input asp-for="Email"
                       class="field"
                       autocomplete="email"
                       placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Password" class="field-label"></label>
                <input asp-for="Password"
                       type="password"
                       class="field"
                       autocomplete="new-password"
                       minlength="6"
                       placeholder="At least 6 characters" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="ConfirmPassword" class="field-label"></label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="field"
                       autocomplete="new-password"
                       placeholder="Repeat your password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <partial name="_FormActions" model='FormActionsViewModel.CancelHome("Register")' />
        </form>

        <p class="empty pt-0">
            Already have an account?
            <a class="link-strong"
               asp-controller="Users"
               asp-action="Login"
               asp-route-returnUrl="@ViewData["ReturnUrl"]">
                Log in
            </a>
        </p>
    </article>
</div>
