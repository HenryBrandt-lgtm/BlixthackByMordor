@model IEnumerable<CategoryModel>
@{
    ViewData["Title"] = "New Category";
}

<div class="page">
    <article class="panel">
        <partial name="_Flash" model='"mx-5 mt-5 mb-0"' />
        <header class="panel-header">
            <p class="eyebrow">New category</p>
        </header>

        <form asp-controller="Categories"
              asp-action="CreateCategory"
              method="post"
              class="panel-body">
            <div class="field-group">
                <label class="field-label" for="categoryName">Category name</label>
                <input id="categoryName"
                       name="categoryName"
                       type="text"
                       class="field"
                       maxlength="100"
                       required
                       placeholder="Enter category name" />
                @Html.ValidationMessage("categoryName", "", new { @class = "field-error" })
            </div>

            <partial name="_FormActions" model='FormActionsViewModel.CancelHome("Create category")' />
        </form>

        <header class="panel-header border-t">
            <p class="eyebrow">Edit category</p>
        </header>
        <form asp-controller="Categories"
              asp-action="EditCategory"
              method="post"
              class="panel-body">
            <div class="field-group">
                <select name="categoryId" class="field">
                    @foreach (var category in Model)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="field-group">
                <label class="field-label" for="newCategoryName">New category name</label>
                <input id="newCategoryName"
                       name="newCategoryName"
                       type="text"
                       class="field"
                       maxlength="100"
                       required
                       placeholder="Enter new category name" />
                @Html.ValidationMessage("newCategoryName", "", new { @class = "field-error" })
            </div>
            <partial name="_FormActions" model='FormActionsViewModel.CancelHome("Edit Category")' />
        </form>
    </article>
</div>
