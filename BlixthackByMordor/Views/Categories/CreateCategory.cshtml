@model IEnumerable<CategoryModel>
@{
    ViewData["Title"] = "New Category";
}

<div class="thread-page">
    <article class="thread-panel">
        @if (TempData["SuccessMessage"] is string message)
        {
            <div class="alert alert-success">
                @message
            </div>
        }
        <header class="thread-panel__header">
            <p class="thread-panel__category">New category</p>
        </header>

        <form asp-controller="Categories"
              asp-action="CreateCategory"
              method="post"
              class="thread-compose">

            <div class="thread-compose__field">
                <label class="thread-compose__label" for="categoryName">Category name</label>

                <input id="categoryName"
                       name="categoryName"
                       type="text"
                       class="form-control thread-compose__control"
                       maxlength="100"
                       required
                       placeholder="Enter category name" />
                @Html.ValidationMessage("categoryName")
            </div>

            <div class="thread-compose__actions">
                <button type="submit" class="btn btn-primary">Create category</button>

                <a class="btn btn-outline-light answer-gate__secondary"
                   asp-controller="Home"
                   asp-action="Index">
                    Cancel
                </a>
            </div>
        </form>

        

        <span></span>



        <header class="thread-panel__header" style="margin-top: 20px;">
            <p class="thread-panel__category">Edit category</p>
        </header>
        <form asp-controller="Categories"
              asp-action="EditCategory"
              method="post"
              class="thread-compose">

            <select name="categoryId"
                    class="form-select form-select-sm w-auto bg-dark text-white">
                
                @foreach (var category in Model)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
            <div class="thread-compose__field">
                <label class="thread-compose__label" for="newCategoryName"></label>
                <input id="newCategoryName"
                       name="newCategoryName"
                       type="text"
                       class="form-control thread-compose__control"
                       maxlength="100"
                       required
                       placeholder="Enter new category name" />
                @Html.ValidationMessage("newCategoryName")
            </div>
            <div class="thread-compose__actions">
                <button type="submit" class="btn btn-primary">Edit Category</button>

                <a class="btn btn-outline-light answer-gate__secondary"
                   asp-controller="Home"
                   asp-action="Index">
                    Cancel
                </a>
            </div>
        </form>

    </article>
</div>