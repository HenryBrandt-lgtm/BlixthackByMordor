@model CategoryModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="thread-page">
    <article class="thread-panel">
        <header class="thread-panel__header">
            <p class="thread-panel__category">Edit category</p>
        </header>

        <form asp-controller="Categories"
              asp-action="EditCategory"
              asp-route-id="@Model.Id"
              method="post"
              class="thread-compose">

            <div class="thread-compose__field">
                <label class="thread-compose__label" for="categoryName">
                    Category name
                </label>

                <input id="categoryName"
                       name="categoryName"
                       type="text"
                       class="form-control thread-compose__control"
                       maxlength="100"
                       required
                       value="@Model.Name" />

                @Html.ValidationMessage("categoryName")
            </div>

            <div class="thread-compose__actions">
                <button type="submit" class="btn btn-primary">
                    Save changes
                </button>

                <a class="btn btn-outline-light answer-gate__secondary"
                   asp-controller="Home"
                   asp-action="Index">
                    Cancel
                </a>
            </div>
        </form>
    </article>
</div>