@model ThreadModel
@{
    ViewData["Title"] = "Edit thread";
    var categories = ViewBag.Categories as List<CategoryModel> ?? new List<CategoryModel>();
}

<div class="thread-page">
    <article class="thread-panel">
        <header class="thread-panel__header">
            <p class="thread-panel__category">Edit thread</p>
        </header>

        <form asp-controller="Threads"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post"
              class="thread-compose">
            <div class="thread-compose__field">
                <label class="thread-compose__label" for="categoryId">Category</label>
                <select id="categoryId"
                        name="categoryId"
                        class="form-select thread-compose__control"
                        required>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <div class="thread-compose__field">
                <label class="thread-compose__label" for="title">Title</label>
                <input id="title"
                       name="title"
                       type="text"
                       class="form-control thread-compose__control"
                       value="@Model.Title"
                       minlength="10"
                       maxlength="100"
                       required
                       placeholder="Give your thread a clear title" />
                <p class="thread-compose__hint">10–100 characters</p>
            </div>

            <div class="thread-compose__actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-light answer-gate__secondary"
                   asp-controller="Threads"
                   asp-action="Details"
                   asp-route-id="@Model.Id">
                    Cancel
                </a>
            </div>
        </form>
    </article>
</div>