@model List<CategoryModel>
@{
    ViewData["Title"] = "New thread";
}

<div class="page">
    <article class="panel">
        <header class="panel-header">
            <p class="eyebrow">New thread</p>
            <p class="byline">Posting as @@@User.Identity!.Name</p>
        </header>

        <form asp-controller="Threads"
              asp-action="CreateThread"
              method="post"
              class="panel-body">
            <div class="field-group">
                <label class="field-label" for="categoryId">Category</label>
                <select id="categoryId"
                        name="categoryId"
                        class="field"
                        required>
                    <option value="">Choose a category</option>
                    @foreach (var category in Model)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>

            <div class="field-group">
                <label class="field-label" for="title">Title</label>
                <input id="title"
                       name="title"
                       type="text"
                       class="field"
                       minlength="10"
                       maxlength="100"
                       required
                       placeholder="Give your thread a clear title" />
                <p class="field-hint">10–100 characters</p>
            </div>

            <div class="field-group">
                <label class="field-label" for="content">Post</label>
                <textarea id="content"
                          name="content"
                          class="field min-h-40 resize-y"
                          rows="8"
                          minlength="1"
                          maxlength="1000"
                          required
                          placeholder="Write the opening post..."></textarea>
                <p class="field-hint">Up to 1000 characters</p>
            </div>

            <partial name="_FormActions" model='FormActionsViewModel.CancelHome("Create thread")' />
        </form>
    </article>
</div>
