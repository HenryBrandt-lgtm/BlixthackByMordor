@model ThreadModel
@{
    ViewData["Title"] = Model.Title;
    var answers = Model.Answers?.ToList() ?? [];
}

<article class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <p class="text-uppercase text-secondary small fw-semibold mb-2">@Model.Category.Name</p>
        <h1 class="h4 fw-semibold mb-3">@Model.Title</h1>
        <p class="text-muted mb-4">
            @@@Model.User.Username
            ·
            @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </p>
        <p class="mb-0">@Model.Content</p>
    </div>
</article>

<section class="mt-4">
    <h2 class="h5 fw-semibold mb-3">Answers</h2>

    @if (answers.Count == 0)
    {
        <p class="text-muted mb-0">No answers yet.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var answer in answers)
            {
                <article class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <p class="text-muted mb-3">
                            @@@answer.User.Username
                            ·
                            @answer.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </p>
                        <p class="mb-0">@answer.Content</p>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4">
        <h2 class="h5 fw-semibold mb-3">Add an answer</h2>
        <form asp-controller="Answers" asp-action="Create" method="post">
            <input type="hidden" name="threadId" value="@Model.Id" />
            <div class="mb-3">
                <label for="content" class="form-label">Your answer</label>
                <textarea id="content"
                          name="content"
                          class="form-control"
                          rows="5"
                          maxlength="1000"
                          required
                          placeholder="Write your answer..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Post answer</button>
        </form>
    </div>
</section>
