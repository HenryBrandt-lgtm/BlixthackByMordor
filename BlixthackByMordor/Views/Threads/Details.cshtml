@using System.Security.Claims
@model ThreadModel
@{
    ViewData["Title"] = Model.Title;
    var answers = ViewBag.Answers as List<AnswerModel> ?? new List<AnswerModel>();
    var replies = ViewBag.Replies as Dictionary<int, List<AnswerModel>>
                  ?? new Dictionary<int, List<AnswerModel>>();
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int.TryParse(currentUserId, out var UserId);

    var isOwner = currentUserId != null && currentUserId == Model.UserId.ToString();
    var isAdmin = currentUserId != null && User.IsInRole("Admin");
    var returnUrl = Url.Action("Details", "Threads", new { id = Model.Id });
}

<div class="thread-page">
    <a class="thread-page__back" asp-controller="Home" asp-action="Index">Back to threads</a>

    <article class="thread-panel">
        <header class="thread-panel__header">
            <p class="thread-panel__category">@Model.Category.Name</p>
            <div class="thread-panel__byline">
                <a class="thread-panel__author"
                   asp-controller="Users"
                   asp-action="Profile"
                   asp-route-id="@Model.UserId">
                    @@@Model.User.Username
                </a>
                <span aria-hidden="true">&middot;</span>
                <time datetime="@Model.CreatedAt.ToString("O")">
                    @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </time>
            </div>
        </header>

        <div class="thread-panel__post">
            <div class="thread-panel__title-row">
                <h1 class="thread-panel__title">@Model.Title</h1>

                @if (isAdmin || isOwner)
                {
                    <div class="thread-panel__actions">
                        @if (isAdmin)
                        {
                            <a asp-controller="Threads" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-light thread-panel__edit-btn">
                                Edit
                            </a>
                        }

                        @if (isOwner || isAdmin)
                        {
                            <form asp-controller="Threads"
                                  asp-action="Delete"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="thread-panel__delete"
                                  onsubmit="return confirm('Delete this thread?');">
                                <button type="submit" class="btn btn-outline-light thread-panel__delete-btn">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
            <p class="thread-panel__content">@Model.Content</p>
        </div>

        <section class="thread-panel__answers" aria-labelledby="answers-heading">
            <div class="thread-panel__answers-head">
                <h2 id="answers-heading" class="thread-panel__answers-title">Answers</h2>
                <span class="thread-panel__count">@ViewBag.TotalAnswers</span>
            </div>

            @if (answers.Count == 0)
            {
                <p class="thread-panel__empty">No answers yet. Be the first to reply.</p>
            }
            else
            {

                <ol class="answer-list">
                    @foreach (var answer in answers)
                    {
                        var initial = string.IsNullOrEmpty(answer.User.Username)
                            ? "?"
                            : answer.User.Username[0].ToString().ToUpperInvariant();
                        @if (answer.ReplyId == null)
                        {
                            <li class="answer-item">
                                <a class="answer-item__avatar-link"
                                   asp-controller="Users"
                                   asp-action="Profile"
                                   asp-route-id="@answer.UserId"
                                   aria-label="@answer.User.Username's profile">
                                    <span class="answer-item__avatar" aria-hidden="true">@initial</span>
                                </a>
                                <div class="answer-item__body">
                                    <div class="thread-panel__byline">
                                        <a class="thread-panel__author"
                                           asp-controller="Users"
                                           asp-action="Profile"
                                           asp-route-id="@answer.UserId">
                                            @@@answer.User.Username
                                        </a>
                                        <span aria-hidden="true">&middot;</span>
                                        <time datetime="@answer.CreatedAt.ToString("O")">
                                            @answer.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                        </time>
                                    </div>
                                    <p class="answer-item__content">@answer.Content</p>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <label class="favorite-toggle">
                                            <input type="checkbox"
                                                   class="favorite-checkbox"
                                                   data-answer-id="@answer.Id"
                                                   @(answer.Favorites?.Any(f => f.UserId == UserId) == true ? "checked" : "") />

                                            <span class="favorite-icon">★</span>
                                            <span class="favorite-text">Favorite</span>
                                        </label>
                                        @if (currentUserId != null && (currentUserId == answer.UserId.ToString() || User.IsInRole("Admin")))
                                        {
                                            <form asp-controller="Answers"
                                                  asp-action="Delete"
                                                  asp-route-id="@answer.Id"
                                                  method="post"
                                                  class="answer-item__delete"
                                                  onsubmit="return confirm('Are you sure you want to delete this answer?');">
                                                <button type="submit" class="btn btn-sm btn-outline-light" aria-label="Delete answer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                                </button>
                                            </form>
                                        }

                                    </div>

                                    @* create a button to submit an answer with a replyid in answerController *@
                                    <h2 id="reply-heading" class="thread-panel__composer-title">Reply</h2>
                                    <p class="thread-panel__composer-meta">Posting as @@@User.Identity!.Name</p>
                                    <form id="create-reply-form-@answer.Id" asp-controller="Answers" asp-action="CreateReply" method="post">
                                        <input type="hidden" name="threadId" value="@answer.ThreadId" />
                                        <input type="hidden" name="answerId" value="@answer.Id" />

                                        <label class="visually-hidden" for="content-@answer.Id">Your answer</label>
                                        <textarea id="content-@answer.Id"
                                                  name="content"
                                                  class="form-control thread-panel__textarea"
                                                  rows="4"
                                                  maxlength="1000"
                                                  placeholder="Write your answer..."></textarea>
                                    </form>
                                    <div class="thread-panel__composer-actions">
                                        <button type="submit" form="create-reply-form-@answer.Id" class="btn btn-primary">Post reply</button>

                                    </div>
                                    

                               

                                </div>

                            </li>
                            @if (replies.ContainsKey(answer.Id) && replies[answer.Id].Any())
                            {
                                <div class="replies">
                                    @foreach (var reply in replies[answer.Id])
                                    {
                                      
                                        <div class="ms-4 mt-3">
                                            <div class="card bg-dark border-secondary">
                                                <div class="card-body py-3">

                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <div class="rounded-circle bg-secondary text-white
                                                        d-flex align-items-center justify-content-center"
                                                             style="width: 36px; height: 36px;">
                                                            @reply.User.Username[0].ToString().ToUpperInvariant()
                                                        </div>

                                                        <div>
                                                            <div class="fw-semibold text-white">
                                                                @@@reply.User.Username
                                                            </div>

                                                            <small class="text-secondary">
                                                                @reply.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                                Reply to: @answer.Content

                                                            </small>
                                                        </div>
                                                    </div>

                                                    <p class="card-text text-light mb-0">
                                                        @reply.Content
                                                    </p>

                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        

                          

                          
                        }

                    }
                </ol>
                @if (totalPages > 1)
                {

                    const int siblingCount = 1; // antal sibling sidor som visas bredvid aktuell sida
                    var startPage = Math.Max(1, currentPage - siblingCount);
                    var endPage = Math.Min(totalPages, currentPage + siblingCount);

                    <nav aria-label="Answer pages" class="answer-pagination">
                        <ul class="pagination">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@(currentPage - 1)">
                                    &laquo;
                                </a>
                            </li>
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Details" asp-route-id="@Model.Id" asp-route-page="1">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (var p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@p">
                                        @p
                                    </a>
                                </li>
                            }
                            @if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@totalPages">@totalPages</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@(currentPage + 1)">
                                    &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </section>

        <section class="thread-panel__composer" aria-labelledby="reply-heading">
            @if (Model.ThreadLocked)
            {
                <h2>THREAD HAS BEEN LOCKED</h2>
                <p>Locked by: @Model.ThreadLockedBy</p>
                <p>Locked at: @Model.ThreadLockedAt</p>

                if (isAdmin)
                {
                    <form asp-controller="Threads"
                          asp-action="Unlock"
                          asp-route-id="@Model.Id"
                          method="post" onsubmit="return confirm('Are you sure you want to UNLOCK the thread?')"
                          style="display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-outline-light" style="height: 40px; width: 40px; padding: 2px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-open">
                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                            </svg>
                        </button>

                    </form>
                }
            }


            else if (isSignedIn)
            {
                <h2 id="reply-heading" class="thread-panel__composer-title">Add an answer</h2>
                <p class="thread-panel__composer-meta">Posting as @@@User.Identity!.Name</p>
                <form id="create-answer-form" asp-controller="Answers" asp-action="Create" method="post">
                    <input type="hidden" name="threadId" value="@Model.Id" />
                    <label class="visually-hidden" for="content">Your answer</label>
                    <textarea id="content"
                              name="content"
                              class="form-control thread-panel__textarea"
                              rows="4"
                              maxlength="1000"
                              required
                              placeholder="Write your answer..."></textarea>
                </form>
                <div class="thread-panel__composer-actions">
                    <button type="submit" form="create-answer-form" class="btn btn-primary">Post answer</button>
                    @if (isAdmin)
                    {
                        <form asp-controller="Threads"
                              asp-action="Lock"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="thread-panel__lock-form"
                              onsubmit="return confirm('Are you sure you want to LOCK the thread?')">
                            <button type="submit" class="btn thread-panel__edit-btn thread-panel__lock-btn" aria-label="Lock thread">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock" aria-hidden="true">
                                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="answer-gate">
                    <div>
                        <h2 id="reply-heading" class="thread-panel__composer-title">Want to reply?</h2>
                        <p class="answer-gate__text">
                            Sign in to post an answer. Anyone can read the discussion.
                        </p>
                    </div>
                    <div class="answer-gate__actions">
                        <a class="btn btn-primary"
                           asp-controller="Users"
                           asp-action="Login"
                           asp-route-returnUrl="@returnUrl">
                            Log in to answer
                        </a>
                        <a class="btn btn-outline-light answer-gate__secondary"
                           asp-controller="Users"
                           asp-action="Register"
                           asp-route-returnUrl="@returnUrl">
                            Create an account
                        </a>
                    </div>
                </div>
            }
        </section>
    </article>
</div>
