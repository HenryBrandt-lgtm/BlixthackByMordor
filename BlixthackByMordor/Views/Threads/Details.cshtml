@model ThreadModel
@{
    ViewData["Title"] = Model.Title;
}

<article class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <p class="text-uppercase text-secondary small fw-semibold mb-2">@Model.Category.Name</p>
        <h1 class="h4 fw-semibold mb-3">@Model.Title</h1>
        <p class="text-muted mb-4">
            @@@Model.User.Username
            ·
            @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </p>
        <p class="mb-0">@Model.Content</p>
    </div>
</article>
