@model IEnumerable<ThreadModel>
@{
    ViewData["Title"] = "Home";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var categories = Model
        .GroupBy(thread => thread.Category.Name)
        .Select(group => new
        {
            Name = group.Key,
            Id = group.First().Category.Id,
            Threads = group.ToList()
        })
        .ToList();

    const int previewCount = 5;
}

<partial name="_Flash" model="null" />
<partial name="_PageHeader" model='new PageHeaderViewModel { Title = "Categories / Threads", ShowNewThread = isSignedIn }' />

@if (categories.Count == 0)
{
    <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border px-6 py-20 text-center">
        <p class="font-medium text-foreground">No threads yet</p>
        <p class="mt-1 text-sm text-muted-foreground">Be the first to start a conversation.</p>
        @if (isSignedIn)
        {
            <a class="btn btn-primary mt-5" asp-controller="Threads" asp-action="CreateThread">New thread</a>
        }
    </div>
}
else
{
    <nav class="mb-8 flex flex-wrap gap-2" aria-label="Categories">
        @foreach (var category in categories)
        {
            <a class="inline-flex items-center gap-2 rounded-full border border-border px-3 py-1 text-sm text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-accent-foreground"
               asp-controller="Categories"
               asp-action="Details"
               asp-route-id="@category.Id">
                @category.Name
                <span class="tabular-nums text-xs">@category.Threads.Count</span>
            </a>
        }
    </nav>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        @foreach (var category in categories)
        {
            var preview = category.Threads.Take(previewCount).ToList();
            var remaining = category.Threads.Count - preview.Count;

            <section data-category-card class="panel flex h-full flex-col">
                <header class="panel-header">
                    <div class="flex min-w-0 items-center gap-2">
                        <h2 class="eyebrow">
                            <a class="text-foreground no-underline hover:text-primary"
                               asp-controller="Categories"
                               asp-action="Details"
                               asp-route-id="@category.Id">
                                @category.Name
                            </a>
                        </h2>
                        <span class="count-badge">@category.Threads.Count</span>
                    </div>
                    @if (preview.Count > 1)
                    {
                        <partial name="_SortMenu" />
                    }
                </header>

                <ul data-thread-list class="thread-list">
                    @foreach (var thread in preview)
                    {
                        <partial name="_ThreadRow" model="thread" />
                    }
                </ul>

                @if (remaining > 0)
                {
                    <div class="px-2 pb-2">
                        <a class="thread-row text-sm text-muted-foreground"
                           asp-controller="Categories"
                           asp-action="Details"
                           asp-route-id="@category.Id">
                            View all · @remaining more
                        </a>
                    </div>
                }
            </section>
        }
    </div>
}
