@model IEnumerable<ThreadModel>
@{
    ViewData["Title"] = "Home Page";
    var categories = Model.GroupBy(thread => thread.Category.Name)
        .ToList();
}
@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">
        @message
    </div>
}

@if (categories.Count == 0)
{
    <div class="text-center text-muted py-5">
        <p class="mb-0">No threads yet.</p>
    </div>
}
else
{
    <div class="row category-grid">
        @foreach (var category in categories)
        {
            <div class="col-12 col-md-6">
                <section class="category-card h-100">
                    <header class="category-header">
                        <h2 class="category-header__title">@category.Key</h2>
                        <select class="form-select form-select-sm w-auto ms-auto bg-dark text-white" onchange="sortThreads(this)">
                            <option value="latest">Latest</option>
                            <option value="oldest">Oldest</option>
                            <option value="most-answers">Most answers</option>
                        </select>
                    </header>
                    <ul class="thread-list">
                        @foreach (var thread in category)
                        {
                            <li class="thread-list__item"data-created="@thread.CreatedAt.Ticks"
                                data-answers="@thread.Answers.Count">

                                <a class="thread-item"
                                   asp-controller="Threads"
                                   asp-action="Details"
                                   asp-route-id="@thread.Id">
                                    <div class="thread-item__content">
                                        <h3 class="thread-item__title">@thread.Title</h3>
                                        <div class="thread-item__byline ">
                                            <span>@@@thread.User.Username</span>

                                            <span aria-hidden="true">&middot;</span>
                                            <time datetime="@thread.CreatedAt.ToString("O")">
                                                @thread.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                            </time>

                                        </div>

                                    </div>
                                    <span class="thread-panel__count ms-auto">Answers: @thread.Answers.Count</span>

                                </a>
                            </li>
                        }
                    </ul>
                </section>
            </div>
        }
    </div>
}
